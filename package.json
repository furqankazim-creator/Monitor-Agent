{
  "name": "time-global-tech-monitor",
  "version": "1.0.0",
  "description": "Time Global Tech Monitor - Monitor Everything. Detect Instantly. Stay Operational.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "web": "node src/server.js --role=web",
    "worker": "node src/server.js --role=worker",
    "create-admin": "node src/cli/create-admin.js",
    "demo": "node src/cli/seed-demo.js",
    "backup": "bash scripts/backup.sh",
    "test": "node --test --test-concurrency=1 --test-timeout=60000 --test-force-exit \"tests/*.test.js\""
  },
  "dependencies": {
    "express": "^4.21.2",
    "mongodb": "7.9.0",
    "nodemailer": "^10.5.0",
    "pdfkit": "^0.15.2"
  },
  "optionalDependencies": {
    "playwright": "1.49.0"
  }
}
